---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import DemoShell from "../../layouts/DemoShell.astro";
import { registry } from "../../lib/registry";

export function getStaticPaths() {
	return registry.map((c) => ({ params: { slug: c.slug }, props: { entry: c } }));
}
const { entry } = Astro.props;
const islands = import.meta.glob<{ default: AstroComponentFactory }>("../../islands/*.astro", { eager: true });
const Island = islands[`../../islands/${entry.name}.astro`].default;
---

<DemoShell slug={entry.slug} title={`${entry.name} demo · Cynco UI`}>
	<Island />
</DemoShell>
