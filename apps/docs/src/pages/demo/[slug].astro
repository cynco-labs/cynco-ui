---
import "../../styles/global.css";
import DemoHost from "../../components/DemoHost";
import interUrl from "@cynco-labs/ui/fonts/Inter-Variable.woff2?url";
import { registry } from "../../lib/registry";
import { PRESET_BOOT } from "../../lib/settings";

export function getStaticPaths() {
	return registry.map((c) => ({ params: { slug: c.slug }, props: { entry: c } }));
}
const { entry } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{entry.name} demo · Cynco UI</title>
		<link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<script is:inline>
			(() => {
				const q = new URLSearchParams(location.search).get("theme");
				const stored = localStorage.getItem("theme");
				const theme = q ?? (stored ? stored : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				document.documentElement.classList.toggle("dark", theme === "dark");
				addEventListener("message", (e) => {
					if (e.data && e.data.type === "cynco-demo-theme") document.documentElement.classList.toggle("dark", e.data.theme === "dark");
				});
			})();
		</script>
		<script is:inline set:html={PRESET_BOOT} />
		<style is:global>
			body {
				background: var(--background);
			}
		</style>
	</head>
	<body data-slug={entry.slug}>
		<div id="demo-root" class="p-4 sm:p-6">
			<DemoHost name={entry.name} client:load />
		</div>
		<script>
			import { startInspect, type DemoInspectMessage } from "../../lib/inspect";

			const report = () => {
				const root = document.getElementById("demo-root")!;
				const height = Math.ceil(Math.max(root.getBoundingClientRect().height, document.body.scrollHeight));
				parent.postMessage({ type: "cynco-demo-size", slug: document.body.dataset.slug, height }, "*");
			};
			if (parent !== window) {
				new ResizeObserver(report).observe(document.getElementById("demo-root")!);
				addEventListener("load", report);
			}

			let stopInspect: (() => void) | null = null;
			addEventListener("message", (e: MessageEvent<DemoInspectMessage>) => {
				if (e.source !== parent || e.data?.type !== "cynco-demo-inspect") return;
				stopInspect?.();
				stopInspect = e.data.on ? startInspect() : null;
			});
		</script>
	</body>
</html>
