---
import Docs from "../layouts/Docs.astro";
---

<Docs title="Page not found" current="/404" wide pager={false}>
	<div class="py-24">
		<p class="font-mono text-sm text-subtle">404</p>
		<h1 class="mt-3 text-display font-semibold tracking-[-0.02em] text-foreground">Page not found</h1>
		<p class="mt-3 text-md text-tertiary-foreground">The page you are looking for doesn't exist. Try the search in the sidebar, or go to <a class="link" href="/components">all components</a>.</p>
	</div>
</Docs>
