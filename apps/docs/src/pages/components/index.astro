---
import Docs from "../../layouts/Docs.astro";
import { byCategory, CATEGORIES, GROUPED, groupsOf, registry } from "../../lib/registry";

const sections = CATEGORIES.map((c) => ({
	...c,
	id: c.name.toLowerCase(),
	groups: GROUPED.has(c.name) ? groupsOf(c.name) : [{ group: "", items: byCategory(c.name) }],
	count: byCategory(c.name).length,
}));
const plain = (s: string) => s.split(String.fromCharCode(96)).join("");
const headings = sections.map((s) => ({ depth: 2, slug: s.id, text: s.name }));
---

<Docs title="Components" description={`All ${registry.length} Cynco UI components by category.`} current="/components" mdHref="/components.md" headings={headings}>
	<article>
		<div class="prose">
			<h1>Components</h1>
			<p class="!mt-3 text-lg text-tertiary-foreground">
				{registry.length} components in six categories. Everything imports from <code>@cynco-labs/ui</code>, except AI components, which import from <code>@cynco-labs/ui/ai</code>.
			</p>
		</div>
		{
			sections.map((s) => (
				<section class="mt-14">
					<div class="flex items-baseline justify-between gap-4 border-b border-border pb-3">
						<h2 id={s.id} class="text-xl font-semibold tracking-[-0.01em] text-foreground">
							{s.name}
						</h2>
						<span class="text-sm tabular-nums text-subtle">{s.count}</span>
					</div>
					<p class="mt-3 text-md text-tertiary-foreground">{s.blurb}</p>
					{s.groups.map((g) => (
						<div class="mt-6">
							{g.group && <h3 class="mb-2 text-sm font-semibold text-muted-foreground">{g.group}</h3>}
							<ul class="grid gap-x-6 sm:grid-cols-2">
								{g.items.map((c) => (
									<li>
										<a href={`/components/${c.slug}`} class="group block rounded-lg px-3 py-2.5 -mx-3 transition-colors hover:bg-muted">
											<span class="block text-md font-medium text-foreground">{c.name}</span>
											<span class="mt-0.5 line-clamp-2 block text-sm leading-snug text-tertiary-foreground">{plain(c.summary)}</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</section>
			))
		}
	</article>
</Docs>
