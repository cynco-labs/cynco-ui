---
import Docs from "../layouts/Docs.astro";
import { FACES, RULES, SIZES, TYPE_CLASSES, WEIGHTS } from "../lib/typography";
import { inlineMd } from "../lib/inline-md";

const headings = [
	{ depth: 2, slug: "typefaces", text: "Typefaces" },
	{ depth: 2, slug: "type-classes", text: "Type classes" },
	{ depth: 2, slug: "sizes", text: "Sizes" },
	{ depth: 2, slug: "weights", text: "Weights" },
	{ depth: 2, slug: "rules", text: "Rules" },
];
---

<Docs title="Typography" description="Inter and JetBrains Mono, the type classes, sizes and weights." current="/typography" mdHref="/typography.md" headings={headings}>
	<article>
		<div class="prose">
			<h1>Typography</h1>
			<p class="!mt-3 text-[16px] text-tertiary-foreground">Inter for the interface, JetBrains Mono for codes and IDs, and a small, tight scale where hierarchy comes from weight and colour.</p>

			<h2 id="typefaces">Typefaces</h2>
		</div>
		<div class="mt-5 grid gap-3 sm:grid-cols-2">
			{
				FACES.map((f) => (
					<div class="rounded-xl border border-border bg-card p-5">
						<div class="flex items-baseline justify-between gap-3">
							<span class="text-[14px] font-semibold text-foreground">{f.name}</span>
							<code class="font-mono text-[11.5px] text-subtle">{f.css}</code>
						</div>
						<p class="mt-4 text-[34px] leading-none tracking-[-0.02em] text-foreground" style={`font-family:${f.family}`}>
							Aa
						</p>
						<p class="mt-3 truncate text-[15px] text-muted-foreground" style={`font-family:${f.family}`}>
							{f.sample}
						</p>
						<p class="mt-3 text-[13px] leading-relaxed text-tertiary-foreground">{f.role}</p>
					</div>
				))
			}
		</div>

		<div class="prose">
			<h2 id="type-classes">Type classes</h2>
			<p>Named classes set size, weight and colour together. Use them for product text; use the Tailwind sizes below when a class doesn't fit.</p>
		</div>
		<div class="mt-5 overflow-hidden rounded-xl border border-border">
			{
				TYPE_CLASSES.map((t) => (
					<div class="grid gap-2 border-b border-border px-4 py-3.5 last:border-b-0 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-center sm:gap-6">
						<div>
							<code class="font-mono text-[12.5px] font-medium text-foreground">{t.cls}</code>
							<p class="mt-0.5 text-[12px] text-subtle">
								{t.size} · {t.weight} · {t.color}
							</p>
						</div>
						<div class="min-w-0">
							<p class:list={[t.cls, "truncate"]}>{t.sample}</p>
							<p class="mt-0.5 text-[12.5px] text-tertiary-foreground">{t.use}</p>
						</div>
					</div>
				))
			}
		</div>

		<div class="prose">
			<h2 id="sizes">Sizes</h2>
			<p>Tailwind sizes are remapped to the product scale. Pair them with a colour utility.</p>
		</div>
		<div class="mt-5 divide-y divide-border rounded-xl border border-border">
			{
				SIZES.map((s) => (
					<div class="flex items-baseline gap-4 px-4 py-3">
						<code class="w-20 shrink-0 font-mono text-[12.5px] text-foreground">{s.cls}</code>
						<span class="w-10 shrink-0 font-mono text-[12px] text-subtle">{s.px}px</span>
						<span class="truncate text-foreground" style={`font-size:${s.px}px`}>
							Trial balance as at 31 October 2026
						</span>
					</div>
				))
			}
		</div>

		<div class="prose">
			<h2 id="weights">Weights</h2>
		</div>
		<div class="mt-5 grid gap-3 sm:grid-cols-3">
			{
				WEIGHTS.map((w) => (
					<div class="rounded-xl border border-border p-4">
						<p class="text-[22px] tracking-[-0.01em] text-foreground" style={`font-weight:${w.value}`}>
							RM 12,720.00
						</p>
						<p class="mt-2 font-mono text-[12px] text-foreground">
							{w.cls} <span class="text-subtle">· {w.value}</span>
						</p>
						<p class="mt-1 text-[12.5px] text-tertiary-foreground">{w.use}</p>
					</div>
				))
			}
		</div>

		<div class="prose">
			<h2 id="rules">Rules</h2>
			<ul>
				{RULES.map((r) => <li set:html={inlineMd(r).replace(/^<p>|<\/p>$/g, "")} />)}
			</ul>
		</div>
	</article>
</Docs>
