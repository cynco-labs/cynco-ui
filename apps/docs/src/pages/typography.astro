---
import Docs from "../layouts/Docs.astro";
import { inlineMd } from "../lib/inline-md";
import { COLOURS, FACES, LEGACY, RULES, SIZES, WEIGHTS } from "../lib/typography";

const headings = [
	{ depth: 2, slug: "typefaces", text: "Typefaces" },
	{ depth: 2, slug: "sizes", text: "Sizes" },
	{ depth: 2, slug: "weights", text: "Weights" },
	{ depth: 2, slug: "colours", text: "Colours" },
	{ depth: 2, slug: "rules", text: "Rules" },
	{ depth: 2, slug: "migrating", text: "Migrating off the old type classes" },
];
---

<Docs title="Typography" description="Inter and JetBrains Mono, the type scale, weights and text colours." current="/typography" mdHref="/typography.md" headings={headings}>
	<article>
		<div class="prose">
			<h1>Typography</h1>
			<p class="!mt-3 text-lg text-tertiary-foreground">Inter for the interface, JetBrains Mono for codes and IDs, and a small, tight scale where hierarchy comes from weight and colour.</p>

			<h2 id="typefaces">Typefaces</h2>
		</div>
		<div class="mt-5 grid gap-3 sm:grid-cols-2">
			{
				FACES.map((f) => (
					<div class="rounded-xl border border-border bg-card p-5">
						<div class="flex items-baseline justify-between gap-3">
							<span class="text-md font-semibold text-foreground">{f.name}</span>
							<code class="font-mono text-xs text-subtle">{f.css}</code>
						</div>
						<p class="mt-4 text-display leading-none tracking-[-0.02em] text-foreground" style={`font-family:${f.family}`}>
							Aa
						</p>
						<p class="mt-3 truncate text-md text-muted-foreground" style={`font-family:${f.family}`}>
							{f.sample}
						</p>
						<p class="mt-3 text-sm leading-relaxed text-tertiary-foreground">{f.role}</p>
					</div>
				))
			}
		</div>

		<div class="prose">
			<h2 id="sizes">Sizes</h2>
			<p>The whole scale. A size class sets size alone, so always pair it with a weight and a colour.</p>
		</div>
		<div class="mt-5 divide-y divide-border rounded-xl border border-border">
			{
				SIZES.map((s) => (
					<div class="grid gap-1 px-4 py-3 sm:grid-cols-[8rem_3rem_minmax(0,1fr)] sm:items-baseline sm:gap-4">
						<code class="font-mono text-sm text-foreground">{s.cls}</code>
						<span class="font-mono text-xs text-subtle">{s.px}px</span>
						<div class="min-w-0">
							<p class:list={[s.cls, "truncate text-foreground"]}>Trial balance as at 31 October 2026</p>
							<p class="mt-0.5 text-sm text-tertiary-foreground">{s.use}</p>
						</div>
					</div>
				))
			}
		</div>

		<div class="prose">
			<h2 id="weights">Weights</h2>
		</div>
		<div class="mt-5 grid gap-3 sm:grid-cols-3">
			{
				WEIGHTS.map((w) => (
					<div class="rounded-xl border border-border p-4">
						<p class:list={["text-xl tracking-[-0.01em] text-foreground", w.cls]}>RM 12,720.00</p>
						<p class="mt-2 font-mono text-xs text-foreground">
							{w.cls} <span class="text-subtle">· {w.value}</span>
						</p>
						<p class="mt-1 text-sm text-tertiary-foreground">{w.use}</p>
					</div>
				))
			}
		</div>

		<div class="prose">
			<h2 id="colours">Colours</h2>
			<p>Five steps of text. Hierarchy comes from these and the weights above, not from jumping a size.</p>
		</div>
		<div class="mt-5 divide-y divide-border rounded-xl border border-border">
			{
				COLOURS.map((c) => (
					<div class="grid gap-1 px-4 py-3 sm:grid-cols-[13rem_minmax(0,1fr)] sm:items-baseline sm:gap-4">
						<code class="font-mono text-sm text-foreground">{c.cls}</code>
						<div class="min-w-0">
							<p class:list={[c.cls, "truncate text-sm font-medium"]}>Payment received from Nusantara Logistik Bhd</p>
							<p class="mt-0.5 text-sm text-tertiary-foreground">{c.use}</p>
						</div>
					</div>
				))
			}
		</div>

		<div class="prose">
			<h2 id="rules">Rules</h2>
			<ul>
				{RULES.map((r) => <li set:html={inlineMd(r).replace(/^<p>|<\/p>$/g, "")} />)}
			</ul>

			<h2 id="migrating">Migrating off the old type classes</h2>
			<p>
				The pre-token classes bundled a size, a weight and usually a colour into one name. They no longer exist. Run
				<code>node scripts/codemods/legacy-type-classes.mjs</code> to rewrite them, or apply this table by hand.
			</p>
		</div>
		<div class="not-prose mt-5 overflow-x-auto rounded-xl border border-border">
			<table class="w-full min-w-[30rem] border-collapse text-left text-sm">
				<thead>
					<tr class="border-b border-border bg-card text-xs text-subtle">
						<th scope="col" class="w-[15rem] px-3.5 py-2 font-medium">Was</th>
						<th scope="col" class="px-3.5 py-2 font-medium">Now</th>
					</tr>
				</thead>
				<tbody>
					{
						LEGACY.map((t) => (
							<tr class="border-b border-border align-top last:border-b-0">
								<td class="px-3.5 py-2.5">
									<code class="font-mono text-xs text-foreground">{t.cls}</code>
								</td>
								<td class="px-3.5 py-2.5">
									{t.now.map((n, i) => (
										<>
											{i > 0 && " "}
											<code class="font-mono text-xs text-tertiary-foreground">{n}</code>
										</>
									))}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</article>
</Docs>
