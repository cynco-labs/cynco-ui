---
import { render } from "astro:content";
import Docs from "../layouts/Docs.astro";
import { changelogEntry, guides } from "../lib/guides";

export async function getStaticPaths() {
	return (await guides()).map((g) => ({ params: { guide: g.id }, props: { guide: g } }));
}
const { guide } = Astro.props;
const entry = guide.id === "changelog" ? await changelogEntry() : guide;
const { Content, headings } = await render(entry);
const current = `/${guide.id}`;
---

<Docs title={guide.data.title} description={guide.data.description} current={current} mdHref={`/${guide.id}.md`} headings={headings}>
	<article class="prose guide">
		<h1>{guide.data.title}</h1>
		<p class="!mt-3 text-lg text-tertiary-foreground">{guide.data.description}</p>
		<Content />
	</article>
</Docs>

<style is:global>
	.guide > h1 + p + h1 {
		display: none;
	}
</style>
