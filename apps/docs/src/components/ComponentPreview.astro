---
import { Code } from "astro:components";
import { SEG, SEG_GROUP } from "../lib/classes";
import { isToggle, type Controls } from "../lib/controls";

interface Props {
	slug: string;
	name: string;
	source: string;
	minHeight: number;
	/** Playground controls the demo declares (`export const controls`). */
	controls?: Controls;
}
const { slug, name, source, minHeight, controls } = Astro.props;
const h = Math.max(120, Math.min(minHeight + 16, 1400));
const controlEntries = Object.entries(controls ?? {});
---

<div class="cy-preview not-prose overflow-hidden rounded-xl border border-border bg-card" data-slug={slug} data-min={h} data-controls={controls ? JSON.stringify(controls) : undefined}>
	<div class="flex flex-wrap items-center justify-between gap-2 border-b border-border px-2 py-1.5">
		<div class={SEG_GROUP} role="tablist" aria-label={`${name} example`}>
			<button type="button" role="tab" class={SEG} data-tab="preview" aria-selected="true">Preview</button>
			<button type="button" role="tab" class={SEG} data-tab="code" aria-selected="false" tabindex="-1">Code</button>
		</div>
		<div class="flex items-center gap-1.5" data-preview-tools>
			<button type="button" class:list={[SEG, "hidden sm:inline-flex"]} data-inspect aria-pressed="false" title="Hover the demo to see sizes, padding and type">
				<svg class="size-3.5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M232 128a104 104 0 0 1-96 103.69V216a8 8 0 0 0-16 0v15.69A104 104 0 0 1 24.31 136H40a8 8 0 0 0 0-16H24.31A104 104 0 0 1 120 24.31V40a8 8 0 0 0 16 0V24.31A104 104 0 0 1 231.69 120H216a8 8 0 0 0 0 16h15.69Z" opacity=".2"></path><path d="M240 120h-8.37A104.16 104.16 0 0 0 136 24.37V16a8 8 0 0 0-16 0v8.37A104.16 104.16 0 0 0 24.37 120H16a8 8 0 0 0 0 16h8.37A104.16 104.16 0 0 0 120 231.63V240a8 8 0 0 0 16 0v-8.37A104.16 104.16 0 0 0 231.63 136H240a8 8 0 0 0 0-16Zm-104 95.54V208a8 8 0 0 0-16 0v7.54A88.17 88.17 0 0 1 40.46 136H48a8 8 0 0 0 0-16h-7.54A88.17 88.17 0 0 1 120 40.46V48a8 8 0 0 0 16 0v-7.54A88.17 88.17 0 0 1 215.54 120H208a8 8 0 0 0 0 16h7.54A88.17 88.17 0 0 1 136 215.54ZM128 88a40 40 0 1 0 40 40 40 40 0 0 0-40-40Zm0 64a24 24 0 1 1 24-24 24 24 0 0 1-24 24Z"></path></svg>
				<span class="ml-1.5 hidden md:inline">Inspect</span>
			</button>
			<div class:list={[SEG_GROUP, "hidden sm:flex"]} role="group" aria-label="Preview width">
				<button type="button" class={SEG} data-width="desktop" aria-pressed="true" title="Full width">
					<svg class="size-3.5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M208 40H48a24 24 0 0 0-24 24v112a24 24 0 0 0 24 24h160a24 24 0 0 0 24-24V64a24 24 0 0 0-24-24Zm8 136a8 8 0 0 1-8 8H48a8 8 0 0 1-8-8V64a8 8 0 0 1 8-8h160a8 8 0 0 1 8 8Zm-48 48a8 8 0 0 1-8 8H96a8 8 0 0 1 0-16h64a8 8 0 0 1 8 8Z"></path></svg>
					<span class="ml-1.5 hidden md:inline">Desktop</span>
				</button>
				<button type="button" class={SEG} data-width="phone" aria-pressed="false" title="360px wide">
					<svg class="size-3.5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M176 16H80a24 24 0 0 0-24 24v176a24 24 0 0 0 24 24h96a24 24 0 0 0 24-24V40a24 24 0 0 0-24-24Zm8 200a8 8 0 0 1-8 8H80a8 8 0 0 1-8-8V40a8 8 0 0 1 8-8h96a8 8 0 0 1 8 8ZM140 60a12 12 0 1 1-12-12 12 12 0 0 1 12 12Z"></path></svg>
					<span class="ml-1.5 hidden md:inline">Phone</span>
				</button>
			</div>
			<div class={SEG_GROUP} role="group" aria-label="Preview theme">
				<button type="button" class={SEG} data-theme-choice="light" aria-pressed="false" title="Light" aria-label="Light">
					<svg class="size-3.5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M120 40V16a8 8 0 0 1 16 0v24a8 8 0 0 1-16 0Zm72 88a64 64 0 1 1-64-64 64.07 64.07 0 0 1 64 64Zm-16 0a48 48 0 1 0-48 48 48.05 48.05 0 0 0 48-48ZM58.34 69.66a8 8 0 0 0 11.32-11.32l-16-16a8 8 0 0 0-11.32 11.32Zm0 116.68-16 16a8 8 0 0 0 11.32 11.32l16-16a8 8 0 0 0-11.32-11.32ZM192 72a8 8 0 0 0 5.66-2.34l16-16a8 8 0 0 0-11.32-11.32l-16 16A8 8 0 0 0 192 72Zm5.66 114.34a8 8 0 0 0-11.32 11.32l16 16a8 8 0 0 0 11.32-11.32ZM48 128a8 8 0 0 0-8-8H16a8 8 0 0 0 0 16h24a8 8 0 0 0 8-8Zm80 80a8 8 0 0 0-8 8v24a8 8 0 0 0 16 0v-24a8 8 0 0 0-8-8Zm112-88h-24a8 8 0 0 0 0 16h24a8 8 0 0 0 0-16Z"></path></svg>
				</button>
				<button type="button" class={SEG} data-theme-choice="dark" aria-pressed="false" title="Dark" aria-label="Dark">
					<svg class="size-3.5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M233.54 142.23a8 8 0 0 0-8-2 88.08 88.08 0 0 1-109.8-109.8 8 8 0 0 0-10-10 104.84 104.84 0 0 0-52.91 37A104 104 0 0 0 136 224a103.09 103.09 0 0 0 62.52-20.88 104.84 104.84 0 0 0 37-52.91 8 8 0 0 0-1.98-7.98Zm-44.64 48.11A88 88 0 0 1 65.66 67.11a89 89 0 0 1 31.4-26A106 106 0 0 0 96 56a104.11 104.11 0 0 0 104 104 106 106 0 0 0 14.92-1.06 89 89 0 0 1-26.02 31.4Z"></path></svg>
				</button>
			</div>
			<a
				href={`/demo/${slug}`}
				target="_blank"
				rel="noopener"
				class="inline-flex size-7 items-center justify-center rounded-md text-tertiary-foreground hover:bg-muted hover:text-foreground"
				title="Open in a new tab"
				aria-label="Open demo in a new tab"
			>
				<svg class="size-3.5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M224 104a8 8 0 0 1-16 0V59.32l-66.33 66.34a8 8 0 0 1-11.32-11.32L196.68 48H152a8 8 0 0 1 0-16h64a8 8 0 0 1 8 8Zm-40 24a8 8 0 0 0-8 8v72H48V80h72a8 8 0 0 0 0-16H48a16 16 0 0 0-16 16v128a16 16 0 0 0 16 16h128a16 16 0 0 0 16-16v-72a8 8 0 0 0-8-8Z"></path></svg>
			</a>
		</div>
		<button type="button" data-copy class="hidden h-7 items-center gap-1.5 rounded-md px-2.5 text-[12.5px] font-medium text-tertiary-foreground hover:bg-muted hover:text-foreground">
			<svg class="size-3.5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M216 32H88a8 8 0 0 0-8 8v40H40a8 8 0 0 0-8 8v128a8 8 0 0 0 8 8h128a8 8 0 0 0 8-8v-40h40a8 8 0 0 0 8-8V40a8 8 0 0 0-8-8Zm-56 176H48V96h112Zm48-48h-32V88a8 8 0 0 0-8-8H96V48h112Z"></path></svg>
			<span>Copy</span>
		</button>
	</div>
	<div data-panel="preview" class="cy-stage bg-background transition-colors">
		<div class="mx-auto transition-[max-width] duration-200" data-frame-wrap style="max-width:100%">
			<iframe
				title={`${name} demo`}
				data-src={`/demo/${slug}`}
				class="block w-full border-0 bg-background"
				style={`height:${h}px`}
				loading="lazy"></iframe>
		</div>
	</div>
	{
		controlEntries.length > 0 && (
			<div data-controls-panel class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border px-3 py-2.5">
				{controlEntries.map(([key, c]) =>
					isToggle(c) ? (
						<button type="button" class={SEG} data-control={key} data-value="true" aria-pressed={String(c.default)}>
							{c.label}
						</button>
					) : (
						<div class="flex items-center gap-2" role="group" aria-label={c.label}>
							<span class="text-[12.5px] text-tertiary-foreground">{c.label}</span>
							<div class={SEG_GROUP}>
								{c.options.map((o) => (
									<button type="button" class={SEG} data-control={key} data-value={o.value} aria-pressed={String(o.value === c.default)}>
										{o.label}
									</button>
								))}
							</div>
						</div>
					),
				)}
				<div class="ml-auto flex items-center gap-1" data-controls-actions hidden>
					<button type="button" data-controls-link class="inline-flex h-7 items-center rounded-md px-2 text-[12.5px] font-medium text-tertiary-foreground hover:bg-muted hover:text-foreground" title="Copy a link to this page with these values">
						Copy link
					</button>
					<button type="button" data-controls-reset class="inline-flex h-7 items-center rounded-md px-2 text-[12.5px] font-medium text-tertiary-foreground hover:bg-muted hover:text-foreground">
						Reset
					</button>
				</div>
			</div>
		)
	}
	<div data-panel="code" hidden class="code-plain max-h-[36rem] overflow-auto bg-card">
		<Code code={source} lang="tsx" themes={{ light: "github-light", dark: "github-dark" }} defaultColor={false} />
		<textarea hidden data-source>{source}</textarea>
	</div>
</div>

<script>
	import { controlsFromQuery, controlsToQuery, isToggle, resolveControls, type ControlValues, type Controls, type DemoPropsMessage } from "../lib/controls";
	import { onSettings, readSettings } from "../lib/settings";
	import { copyWithFeedback } from "../lib/copy";

	function siteTheme() {
		return document.documentElement.classList.contains("dark") ? "dark" : "light";
	}
	const previews = [...document.querySelectorAll<HTMLElement>(".cy-preview")];
	for (const el of previews) {
		const iframe = el.querySelector("iframe")!;
		const wrap = el.querySelector<HTMLElement>("[data-frame-wrap]")!;
		const stage = el.querySelector<HTMLElement>(".cy-stage")!;
		const min = Number(el.dataset.min);
		let theme = siteTheme();
		let pinned = false;

		const setThemeButtons = () => {
			for (const b of el.querySelectorAll<HTMLButtonElement>("[data-theme-choice]")) b.setAttribute("aria-pressed", String(b.dataset.themeChoice === theme));
			stage.classList.toggle("dark", theme === "dark");
		};
		const applyTheme = () => {
			setThemeButtons();
			iframe.contentWindow?.postMessage({ type: "cynco-demo-theme", theme }, "*");
		};
		iframe.src = `${iframe.dataset.src}?theme=${theme}`;
		setThemeButtons();

		for (const b of el.querySelectorAll<HTMLButtonElement>("[data-theme-choice]")) {
			b.addEventListener("click", () => {
				theme = b.dataset.themeChoice!;
				pinned = true;
				applyTheme();
			});
		}
		window.addEventListener("site-theme", (e) => {
			if (pinned) return;
			theme = (e as CustomEvent).detail;
			applyTheme();
		});
		for (const b of el.querySelectorAll<HTMLButtonElement>("[data-width]")) {
			b.addEventListener("click", () => {
				const phone = b.dataset.width === "phone";
				wrap.style.maxWidth = phone ? "360px" : "100%";
				wrap.classList.toggle("cy-phone", phone);
				for (const o of el.querySelectorAll<HTMLButtonElement>("[data-width]")) o.setAttribute("aria-pressed", String(o === b));
			});
		}
		const inspect = el.querySelector<HTMLButtonElement>("[data-inspect]")!;
		const postInspect = () => iframe.contentWindow?.postMessage({ type: "cynco-demo-inspect", on: inspect.getAttribute("aria-pressed") === "true" }, location.origin);
		inspect.addEventListener("click", () => {
			inspect.setAttribute("aria-pressed", String(inspect.getAttribute("aria-pressed") !== "true"));
			postInspect();
		});

		const controls: Controls | null = el.dataset.controls ? JSON.parse(el.dataset.controls) : null;
		const panel = el.querySelector<HTMLElement>("[data-controls-panel]");
		let overrides: ControlValues = {};
		const postProps = () => iframe.contentWindow?.postMessage({ type: "cynco-demo-props", overrides } satisfies DemoPropsMessage, location.origin);
		if (controls && panel) {
			const actions = panel.querySelector<HTMLElement>("[data-controls-actions]")!;
			const reset = panel.querySelector<HTMLButtonElement>("[data-controls-reset]")!;
			const link = panel.querySelector<HTMLButtonElement>("[data-controls-link]")!;
			overrides = controlsFromQuery(controls, new URLSearchParams(location.search));
			const sync = () => {
				const values = resolveControls(controls, readSettings(), overrides);
				for (const b of panel.querySelectorAll<HTMLButtonElement>("[data-control]")) {
					const v = values[b.dataset.control!];
					b.setAttribute("aria-pressed", String(typeof v === "boolean" ? v : v === b.dataset.value));
				}
				actions.hidden = Object.keys(overrides).length === 0;
				const query = controlsToQuery(controls, overrides, new URLSearchParams(location.search)).toString();
				history.replaceState(history.state, "", `${location.pathname}${query ? `?${query}` : ""}${location.hash}`);
			};
			link.addEventListener("click", async () => {
				await copyWithFeedback(link, location.href);
			});
			panel.addEventListener("click", (e) => {
				const b = (e.target as Element).closest<HTMLButtonElement>("[data-control]");
				if (!b) return;
				const key = b.dataset.control!;
				const current = resolveControls(controls, readSettings(), overrides)[key];
				overrides = { ...overrides, [key]: isToggle(controls[key]) ? !current : b.dataset.value! };
				sync();
				postProps();
			});
			reset.addEventListener("click", () => {
				overrides = {};
				sync();
				postProps();
			});
			onSettings(sync);
			sync();
		}

		window.addEventListener("message", (e) => {
			if (e.source !== iframe.contentWindow) return;
			if (e.data?.type === "cynco-demo-size") iframe.style.height = `${Math.max(min, Math.min(e.data.height, 2400))}px`;
			if (e.data?.type === "cynco-demo-ready") {
				if (Object.keys(overrides).length) postProps();
				postInspect();
			}
		});

		const tools = el.querySelector<HTMLElement>("[data-preview-tools]")!;
		const copy = el.querySelector<HTMLButtonElement>("[data-copy]")!;
		const tabs = [...el.querySelectorAll<HTMLButtonElement>("[data-tab]")];
		for (const tab of tabs) {
			// APG tabs: the selected tab is the group's only Tab stop; arrows, Home and End move and select.
			tab.addEventListener("keydown", (e) => {
				if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
				const at = tabs.indexOf(tab);
				const next = e.key === "ArrowRight" ? (at + 1) % tabs.length : e.key === "ArrowLeft" ? (at - 1 + tabs.length) % tabs.length : e.key === "Home" ? 0 : e.key === "End" ? tabs.length - 1 : -1;
				if (next < 0) return;
				e.preventDefault();
				tabs[next].click();
				tabs[next].focus();
			});
			tab.addEventListener("click", () => {
				const code = tab.dataset.tab === "code";
				for (const t of tabs) {
					t.setAttribute("aria-selected", String(t === tab));
					t.tabIndex = t === tab ? 0 : -1;
				}
				el.querySelector<HTMLElement>('[data-panel="preview"]')!.hidden = code;
				el.querySelector<HTMLElement>('[data-panel="code"]')!.hidden = !code;
				tools.classList.toggle("hidden", code);
				tools.classList.toggle("flex", !code);
				if (panel) panel.hidden = code;
				copy.classList.toggle("hidden", !code);
				copy.classList.toggle("inline-flex", code);
			});
		}
		copy.addEventListener("click", async () => {
			await copyWithFeedback(copy.querySelector("span")!, el.querySelector<HTMLTextAreaElement>("[data-source]")!.value);
		});
	}
</script>

<style>
	.cy-phone {
		border-left: 1px solid var(--border);
		border-right: 1px solid var(--border);
	}
	.cy-stage:has(.cy-phone) {
		background-color: var(--outer-background);
	}
</style>
