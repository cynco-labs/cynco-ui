---
import { KBD, SEG, SEG_GROUP } from "../lib/classes";
import { ACCENT_SHORTCUT, DEFAULT_SETTINGS, SETTINGS } from "../lib/settings";
import { ACCENT_ORDER, ACCENTS } from "../lib/theme";

interface Props {
	/** `panel`: one setting per row (header popover). `strip`: settings side by side, wrapping (home page). */
	variant?: "panel" | "strip";
}
const { variant = "panel" } = Astro.props;
const row = ["flex items-center gap-3", variant === "panel" && "justify-between"];
const SWATCH =
	"relative size-5 shrink-0 rounded-full shadow-[inset_0_0_0_1px_rgb(0_0_0/0.12)] outline-offset-2 transition-transform hover:scale-110 focus-visible:outline-2 focus-visible:outline-focus-ring aria-pressed:outline-2 aria-pressed:outline-foreground data-[active=true]:outline-2 data-[active=true]:outline-foreground dark:shadow-[inset_0_0_0_1px_rgb(255_255_255/0.14)]";
---

<div class:list={[variant === "strip" ? "flex flex-wrap items-center gap-x-6 gap-y-3" : "grid gap-2.5"]} data-settings>
	<div class:list={row} role="group" aria-label="Accent">
		<span class="flex items-center gap-1.5 text-sm text-tertiary-foreground">
			Accent
			<kbd class:list={[KBD, "max-sm:hidden"]} title={`Press ${ACCENT_SHORTCUT.toUpperCase()} to switch`}>{ACCENT_SHORTCUT.toUpperCase()}</kbd>
		</span>
		<div class="flex items-center gap-1.5 py-1">
			{
				ACCENT_ORDER.map((id) => (
					<button
						type="button"
						class={`${SWATCH} bg-[var(--sw-l)] dark:bg-[var(--sw-d)]`}
						style={`--sw-l:${ACCENTS[id].light};--sw-d:${ACCENTS[id].dark}`}
						data-accent={id}
						aria-label={ACCENTS[id].label}
						title={ACCENTS[id].label}
						aria-pressed={String(id === DEFAULT_SETTINGS.accent)}
					/>
				))
			}
			<label class={`${SWATCH} cursor-pointer bg-[conic-gradient(var(--status-red),var(--status-amber),var(--status-green),var(--status-blue),var(--status-purple),var(--status-red))] has-focus-visible:outline-2 has-focus-visible:outline-focus-ring`} title="Your own colour" data-accent-custom data-active="false">
				<input type="color" class="absolute inset-0 size-full cursor-pointer opacity-0" aria-label="Your own accent colour" value="#0067d1" />
			</label>
		</div>
	</div>
	{
		SETTINGS.map((s) => (
			<div class:list={row} role="group" aria-label={s.label}>
				<span class="flex items-center gap-1.5 text-sm text-tertiary-foreground">
					{s.label}
					<kbd class:list={[KBD, "max-sm:hidden"]} title={`Press ${s.shortcut.toUpperCase()} to switch`}>
						{s.shortcut.toUpperCase()}
					</kbd>
				</span>
				<div class={SEG_GROUP}>
					{s.options.map((o) => (
						<button type="button" class={SEG} data-setting={s.key} data-value={o.value} aria-pressed={String(o.value === DEFAULT_SETTINGS[s.key])}>
							{o.label}
						</button>
					))}
				</div>
			</div>
		))
	}
	<div class:list={["flex items-center gap-3", variant === "panel" ? "justify-end border-t border-border pt-3" : ""]}>
		<p class="mr-auto text-xs leading-snug text-subtle empty:hidden" data-accent-note></p>
		<button
			type="button"
			data-copy-theme
			class="inline-flex h-7 shrink-0 items-center gap-1.5 rounded-md border border-border bg-interactive-secondary px-2.5 text-sm font-medium text-foreground transition-colors hover:bg-interactive-secondary-hover"
			title="Copy the CSS and setup for these settings"
		>
			<svg class="size-3.5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M216 32H88a8 8 0 0 0-8 8v40H40a8 8 0 0 0-8 8v128a8 8 0 0 0 8 8h128a8 8 0 0 0 8-8v-40h40a8 8 0 0 0 8-8V40a8 8 0 0 0-8-8Zm-56 176H48V96h112Zm48-48h-32V88a8 8 0 0 0-8-8H96V48h112Z"></path></svg>
			<span>Copy theme</span>
		</button>
	</div>
</div>

<script>
	import { ACCENT_SHORTCUT, SETTINGS, applySettings, onSettings, parseSettings, readSettings, themeSnippet, writeSettings, type SiteSettings } from "../lib/settings";
	import { ACCENTS, ACCENT_ORDER, customAccent, isAccentPreset, isHex, type Accent } from "../lib/theme";
	import { copyWithFeedback } from "../lib/copy";

	// Values arrive as data attributes and input values; parseSettings drops anything that isn't a valid setting.
	const set = (patch: Record<string, string>) => writeSettings(parseSettings(JSON.stringify({ ...readSettings(), ...patch })));

	const live = document.createElement("div");
	live.className = "sr-only";
	live.setAttribute("aria-live", "polite");
	document.body.append(live);

	function sync(s: SiteSettings) {
		for (const b of document.querySelectorAll<HTMLButtonElement>("[data-setting]")) {
			b.setAttribute("aria-pressed", String(s[b.dataset.setting as keyof SiteSettings] === b.dataset.value));
		}
		for (const b of document.querySelectorAll<HTMLButtonElement>("[data-accent]")) b.setAttribute("aria-pressed", String(b.dataset.accent === s.accent));
		const custom = isHex(s.accent) ? customAccent(s.accent) : null;
		for (const l of document.querySelectorAll<HTMLLabelElement>("[data-accent-custom]")) {
			l.dataset.active = String(custom !== null);
			l.style.background = custom ? (document.documentElement.classList.contains("dark") ? custom.dark : custom.light) : "";
			const input = l.querySelector("input")!;
			input.setAttribute("aria-label", custom ? `Your own accent colour, ${s.accent} (selected)` : "Your own accent colour");
			if (isHex(s.accent) && input.value !== s.accent) input.value = s.accent;
		}
		for (const p of document.querySelectorAll<HTMLElement>("[data-accent-note]")) {
			p.textContent = custom?.adjusted ? "Your colour is adjusted where needed so text and focus rings stay readable." : "";
		}
	}
	sync(readSettings());
	onSettings(sync);
	window.addEventListener("site-theme", () => sync(readSettings()));

	document.addEventListener("click", async (e) => {
		const target = e.target as Element;
		const seg = target.closest<HTMLButtonElement>("[data-setting]");
		if (seg) set({ [seg.dataset.setting!]: seg.dataset.value! });
		const swatch = target.closest<HTMLButtonElement>("[data-accent]");
		if (swatch?.dataset.accent) set({ accent: swatch.dataset.accent });
		const copy = target.closest<HTMLButtonElement>("[data-copy-theme]");
		if (copy) {
			await copyWithFeedback(copy.querySelector("span")!, themeSnippet(readSettings()));
		}
	});
	// While the picker drags, preview on this page only; the setting is written (and reaches the demos) on change.
	const customValue = (e: Event) => {
		const input = e.target;
		return input instanceof HTMLInputElement && input.closest("[data-accent-custom]") && isHex(input.value) ? input.value : null;
	};
	document.addEventListener("input", (e) => {
		const accent = customValue(e);
		if (!accent) return;
		const preview: SiteSettings = { ...readSettings(), accent };
		applySettings(preview);
		sync(preview);
	});
	document.addEventListener("change", (e) => {
		const accent = customValue(e);
		if (accent) set({ accent });
	});
	// A picker closed without choosing leaves only a preview behind; put the saved settings back.
	document.addEventListener("focusout", (e) => {
		if (!(e.target instanceof HTMLInputElement) || !e.target.closest("[data-accent-custom]")) return;
		applySettings(readSettings());
		sync(readSettings());
	});

	document.addEventListener("keydown", (e) => {
		const t = e.target instanceof HTMLElement ? e.target : document.body;
		if (e.defaultPrevented || e.repeat || e.metaKey || e.ctrlKey || e.altKey || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable) return;
		if (t.closest("[role=listbox],[role=menu],[role=grid],[role=tree],[role=combobox],[role=dialog]")) return;
		const key = e.key.toLowerCase();
		const step = e.shiftKey ? -1 : 1;
		const cycle = <V,>(list: readonly V[], current: V) => list[(list.indexOf(current) + step + list.length) % list.length];
		if (key === ACCENT_SHORTCUT) {
			const current: Accent = readSettings().accent;
			const next = isAccentPreset(current) ? cycle(ACCENT_ORDER, current) : ACCENT_ORDER[0];
			set({ accent: next });
			live.textContent = `Accent: ${ACCENTS[next].label}`;
			return;
		}
		const def = SETTINGS.find((s) => s.shortcut === key);
		if (!def) return;
		const options: readonly { value: string; label: string }[] = def.options;
		const current = readSettings()[def.key];
		const next = cycle(options, options.find((o) => o.value === current) ?? options[0]);
		set({ [def.key]: next.value });
		live.textContent = `${def.label}: ${next.label}`;
	});
</script>
