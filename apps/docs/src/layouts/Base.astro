---
import "../styles/global.css";
import interUrl from "@cynco-labs/ui/fonts/Inter-Variable.woff2?url";
import SettingsBoot from "../components/SettingsBoot.astro";
import { ogPath } from "../lib/og";

interface Props {
	title: string;
	description?: string;
	mdHref?: string;
	bodyClass?: string;
	/** Keep the page out of search results (the 404). */
	noindex?: boolean;
}
const {
	title,
	description = "Cynco UI: the design system for accounting and ERP interfaces.",
	mdHref,
	bodyClass = "",
	noindex = false,
} = Astro.props;
const fullTitle = title === "Cynco UI" ? "Cynco UI" : `${title} · Cynco UI`;
// `build.format: "file"` writes /cli.html, but the host serves it at /cli and redirects the .html form there,
// so the canonical names the URL that answers 200: the one every internal link and the sitemap use.
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/";
const canonical = Astro.site && !noindex ? new URL(path, Astro.site).href : undefined;
// Each indexable page has its own preview (src/pages/og); the 404 borrows the home page's.
const image = Astro.site ? new URL(`${ogPath(noindex ? "/" : path)}.png`, Astro.site).href : undefined;
const imageAlt = noindex ? "Cynco UI" : `${title}: ${description}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Cynco UI" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		{image && <meta property="og:image" content={image} />}
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		{mdHref && <link rel="alternate" type="text/markdown" href={mdHref} title="Markdown" />}
		<link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
		<script is:inline>
			(() => {
				const stored = localStorage.getItem("theme");
				const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", dark);
			})();
		</script>
	</head>
	<body class={bodyClass}>
		<SettingsBoot />
		<slot />
	</body>
</html>
