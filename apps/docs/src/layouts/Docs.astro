---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Toc from "../components/Toc.astro";
import { neighbours } from "../lib/nav";
import Base from "./Base.astro";

interface Props {
	title: string;
	description?: string;
	current: string;
	mdHref?: string;
	headings?: { depth: number; slug: string; text: string }[];
	/** Hide the right-hand table of contents and let content use the full width. */
	wide?: boolean;
	pager?: boolean;
	noindex?: boolean;
}
const { title, description, current, mdHref, headings = [], wide = false, pager = true, noindex } = Astro.props;
const { prev, next } = neighbours(current);
---

<Base title={title} description={description} mdHref={mdHref} noindex={noindex}>
	<a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded-md focus:bg-background focus:px-3 focus:py-2">Skip to content</a>
	<Header current={current} />
	<div class="mx-auto flex max-w-[90rem] px-0 lg:px-8">
		<Sidebar current={current} />
		<main id="content" data-prev={prev?.href} data-next={next?.href} class="min-w-0 flex-1 px-4 pb-24 pt-8 sm:px-6 lg:pl-10 lg:pr-2 min-[1360px]:pr-10">
			<div class:list={["mx-auto", wide ? "max-w-[64rem]" : "max-w-[52rem]"]}>
				<slot />
				{
					pager && (prev || next) && (
						<nav class="mt-20 grid gap-3 border-t border-border pt-6 sm:grid-cols-2" aria-label="Pagination">
							{prev ? (
								<a href={prev.href} class="group rounded-xl border border-border px-4 py-3 transition-colors hover:border-input-border-hover hover:bg-card">
									<span class="block text-xs text-subtle">Previous</span>
									<span class="mt-0.5 block text-md font-medium text-foreground">{prev.label}</span>
								</a>
							) : (
								<span />
							)}
							{next && (
								<a href={next.href} class="group rounded-xl border border-border px-4 py-3 text-right transition-colors hover:border-input-border-hover hover:bg-card">
									<span class="block text-xs text-subtle">Next</span>
									<span class="mt-0.5 block text-md font-medium text-foreground">{next.label}</span>
								</a>
							)}
						</nav>
					)
				}
			</div>
		</main>
		{!wide && <Toc headings={headings} mdHref={mdHref} />}
	</div>
</Base>

<script>
	import { copyWithFeedback } from "../lib/copy";

	// ← and → step through pages in reading order, as the arrows beside a component's title do.
	document.addEventListener("keydown", (e) => {
		const t = e.target as HTMLElement;
		// Only when focus is on the page or a link: buttons, grids and calendars use the arrows themselves.
		if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey || e.shiftKey || (t !== document.body && !(t instanceof HTMLAnchorElement))) return;
		const href = e.key === "ArrowLeft" ? document.getElementById("content")?.dataset.prev : e.key === "ArrowRight" ? document.getElementById("content")?.dataset.next : undefined;
		if (href) location.href = href;
	});

	// Copy buttons on code blocks in prose
	for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre.astro-code")) {
		const wrap = document.createElement("div");
		wrap.className = "group/code relative";
		pre.replaceWith(wrap);
		wrap.append(pre);
		const b = document.createElement("button");
		b.type = "button";
		b.className = "absolute right-2 top-2 rounded-md border border-border bg-background px-2 py-0.5 text-xs font-medium text-tertiary-foreground opacity-0 transition-opacity hover:text-foreground focus-visible:opacity-100 group-hover/code:opacity-100 no-hover:opacity-100";
		b.textContent = "Copy";
		b.addEventListener("click", async () => {
			await copyWithFeedback(b, pre.innerText);
		});
		wrap.append(b);
	}
</script>
