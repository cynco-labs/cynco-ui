{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"packages/ui/src/**",
			"apps/docs/src/**",
			"scripts/**",
			"!**/node_modules",
			"!**/dist",
			"!packages/ui/registry",
			"!apps/docs/src/islands",
			"!**/*.css",
			"!**/*.md"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 1,
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"json": {
		"formatter": { "indentStyle": "tab", "lineWidth": 120 }
	},
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"preset": "recommended",
				"noLabelWithoutControl": {
					"level": "error",
					"options": {
						"inputComponents": [
							"Input",
							"Textarea",
							"Checkbox",
							"RadioGroupItem",
							"Switch",
							"Select",
							"SelectTrigger",
							"AmountInput"
						]
					}
				}
			},
			"style": {
				"useImportType": "error",
				"useExportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
