{
  "name": "@cynco-labs/ui",
  "version": "0.2.0",
  "description": "Cynco's design system for accounting and ERP interfaces: components, layout primitives, productivity patterns and printable business documents.",
  "type": "module",
  "license": "MIT AND Apache-2.0",
  "private": false,
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./theme.css": "./dist/styles/theme.css",
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/styles/fonts.css",
    "./fonts/*": "./fonts/*",
    "./registry/components.json": "./registry/components.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "cynco-ui": "./bin/cynco-ui.mjs"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "bin",
    "dist",
    "fonts",
    "registry",
    "skills"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "check:rsc": "node scripts/check-rsc.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@squircle/tailwindcss": "^1.0.6",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "motion": "^12.26.1",
    "react-day-picker": "^10.0.2",
    "react-hotkeys-hook": "^4.6.1",
    "react-resizable-panels": "^4.11.0",
    "recharts": "3.9.2",
    "tailwind-merge": "^3.0.2",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.0",
    "@xyflow/react": "^12.11.0",
    "ai": "^6.0.5",
    "nanoid": "^5.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^3.20.0",
    "streamdown": "^1.6.10",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.1"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "nanoid": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "streamdown": {
      "optional": true
    },
    "tokenlens": {
      "optional": true
    },
    "use-stick-to-bottom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/cli": "^4.0.13",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.11.0",
    "ai": "^6.0.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "nanoid": "^5.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^3.20.0",
    "streamdown": "^1.6.10",
    "tailwindcss": "^4.0.13",
    "tokenlens": "^1.3.1",
    "typescript": "~5.7.2",
    "use-stick-to-bottom": "^1.1.1",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cynco-labs/cynco-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://ui.cynco.io",
  "bugs": "https://github.com/cynco-labs/cynco-ui/issues",
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "ui",
    "tailwindcss",
    "base-ui",
    "accounting",
    "erp",
    "invoice",
    "bookkeeping",
    "ledger",
    "payroll",
    "bank-reconciliation",
    "financial-statements",
    "malaysia",
    "sst",
    "e-invoice",
    "myinvois"
  ]
}
