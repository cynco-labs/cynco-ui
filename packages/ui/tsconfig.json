{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "ES2023.Intl",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@cynco-labs/ui/ai": ["./src/ai.ts"],
      "@cynco-labs/ui": ["./src/index.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "../../apps/docs/src/demos"
  ]
}
